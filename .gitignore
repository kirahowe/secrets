target/
.cpcache/
# Track the project lint policy while ignoring clj-kondo caches and imported configs.
!/.clj-kondo/
/.clj-kondo/*
!/.clj-kondo/config.edn
.lsp/
.nrepl-port
.portal/
*.log
.DS_Store

# Scratch space for the demo `bb secrets` task — never commit decrypted secrets.
tmp/

# Rendered documentation book (regenerate with `bb book:build`).
book/rendered/

# Argument-boundary regression fixtures, for age's options and for the CLI's own
# flags. The tests create these in the repo root and delete them in a `finally`;
# only a path relative to the JVM's working directory produces a dash-leading
# argv element, so they cannot live in a temp dir. These entries are the safety
# net for an interrupted run.
/--version
/--help
/--armor
/-
/--edn
/--edn.age
/-secrets-boundary/
/-secrets-cli-boundary/
/-secrets-cli-boundary-delete
/-secrets-cli-boundary-editor/
