;; Tasks for developing, building, and publishing the library itself.
;; (Consumers wire `com.kirahowe.secrets.cli` into their *own* bb.edn — see the
;; README.) The build/install/deploy tasks shell out to `clojure -T:build …`,
;; which needs a JDK on the PATH; everything else runs under babashka alone.
{:paths ["src" "test"]
 :deps  {aero/aero {:mvn/version "1.1.6"}}

 :tasks
 {test
  {:doc      "Run the test suite under babashka"
   :requires ([clojure.test :as t]
              [com.kirahowe.secrets-test]
              [com.kirahowe.secrets.cli-test]
              [com.kirahowe.secrets.aero-test])
   :task     (let [{:keys [fail error]} (t/run-tests 'com.kirahowe.secrets-test
                                                     'com.kirahowe.secrets.cli-test
                                                     'com.kirahowe.secrets.aero-test)]
               (System/exit (if (pos? (+ fail error)) 1 0)))}

  clean
  {:doc  "Remove the target/ build directory"
   :task (clojure "-T:build clean")}

  build
  {:doc  "Build the library jar (target/secrets-<version>.jar)"
   :task (clojure "-T:build jar")}

  install
  {:doc  "Build + install the jar to the local Maven repo (~/.m2)"
   :task (clojure "-T:build install")}

  deploy
  {:doc  "Build + publish to Clojars (needs CLOJARS_USERNAME / CLOJARS_PASSWORD)"
   :task (clojure "-T:build deploy")}

  secrets
  {:doc      "Demo of the management CLI against a throwaway tmp/ secrets file"
   :requires ([com.kirahowe.secrets.cli :as cli])
   :task     (cli/run! {:app "kira-secrets-demo"
                        :default-environment :dev
                        :environments {:dev {:secrets-file "tmp/secrets.edn.age"}}}
                       *command-line-args*)}

  ;; ---- Documentation book (Clay + Quarto; see clay.edn) --------------------
  ;; The book tasks shell out to `clojure -M:book`, so they need a JDK and the
  ;; `quarto` CLI on the PATH (and `age`, since the chapters run real examples).

  book:build
  {:doc      "Render the documentation book (Clay + Quarto) into book/rendered"
   :requires ([babashka.fs :as fs])
   :task     (do (when (fs/exists? "book/rendered")
                   (fs/delete-tree "book/rendered"))
                 (clojure "-M:book -m scicloj.clay.v2.main -r"))}

  book:preview
  {:doc      "Serve the rendered book locally via `quarto preview` (builds first if needed)"
   :requires ([babashka.fs :as fs])
   :task     (do (when-not (fs/exists? "book/rendered/_quarto.yml")
                   (run 'book:build))
                 (shell "quarto preview book/rendered"))}

  book:watch
  {:doc      "Watch the chapters and re-render on save (Clay live reload)"
   :requires ([babashka.fs :as fs])
   ;; Start from a clean slate: leftover HTML from a previous book:build
   ;; confuses quarto's incremental render inside watch mode.
   :task     (do (when (fs/exists? "book/rendered")
                   (fs/delete-tree "book/rendered"))
                 (clojure "-M:book -m scicloj.clay.v2.main book/chapters"))}}}
