;;; Tasks for developing, building, and publishing the library itself.
;;; (Consumers wire `com.kirahowe.secrets.cli` into their *own* bb.edn — see the
;;; README.) The build/install/release tasks shell out to `clojure -T:build …`
;;; and deploy to `clojure -M:deploy`, all of which need a JDK on the PATH.
;;; The test task also needs Java because this bb.edn resolves Maven
;;; dependencies before Babashka can load them.
{:paths ["src" "test" "build"]
 :deps {aero/aero {:mvn/version "1.1.6"}
        org.clojure/test.check {:mvn/version "1.1.3"}}

 :tasks
 {test
  {:doc "Run the test suite under babashka"
   ;; JVM-only policy tests are deliberately absent. Publish-policy needs
   ;; com.sun.net.httpserver.HttpServer; dependency-audit-test loads the JVM
   ;; runner and its test-only org.clojure/data.json dependency.
   ;; `clojure -M:test` runs both without adding tooling to this Babashka
   ;; classpath.
   :requires ([clojure.test :as t]
              [com.kirahowe.secrets-test]
              [com.kirahowe.secrets.aero-test]
              [com.kirahowe.secrets.age-property-test]
              [com.kirahowe.secrets.cli-property-test]
              [com.kirahowe.secrets.cli-test]
              [com.kirahowe.secrets.coordinate-test]
              [com.kirahowe.secrets.fs-property-test]
              [com.kirahowe.secrets.init-property-test]
              [com.kirahowe.secrets.init-test]
              [com.kirahowe.secrets.manifest-property-test]
              [com.kirahowe.secrets.release-test]
              [com.kirahowe.secrets.safe-edn-property-test]
              [com.kirahowe.secrets.secrets-property-test]
              [com.kirahowe.secrets.site-policy-test]
              [com.kirahowe.secrets.source-property-test]
              [com.kirahowe.secrets.workflow-policy-test])
   :task (let [{:keys [fail error]} (t/run-tests 'com.kirahowe.secrets-test
                                                 'com.kirahowe.secrets.cli-test
                                                 'com.kirahowe.secrets.aero-test
                                                 'com.kirahowe.secrets.coordinate-test
                                                 'com.kirahowe.secrets.init-test
                                                 'com.kirahowe.secrets.release-test
                                                 'com.kirahowe.secrets.site-policy-test
                                                 'com.kirahowe.secrets.workflow-policy-test
                                                 'com.kirahowe.secrets.safe-edn-property-test
                                                 'com.kirahowe.secrets.manifest-property-test
                                                 'com.kirahowe.secrets.cli-property-test
                                                 'com.kirahowe.secrets.init-property-test
                                                 'com.kirahowe.secrets.secrets-property-test
                                                 'com.kirahowe.secrets.source-property-test
                                                 'com.kirahowe.secrets.age-property-test
                                                 'com.kirahowe.secrets.fs-property-test)]
           (System/exit (if (pos? (+ fail error)) 1 0)))}

  ;;;; Code quality

  audit
  {:doc "Resolve and scan every dependency graph with pinned OSV-Scanner"
   :task (apply clojure "-M:audit" *command-line-args*)}

  format
  {:doc "Format Clojure source with cljfmt"
   :task (clojure "-M:format fix")}

  format:check
  {:doc "Check Clojure formatting with cljfmt"
   :task (clojure "-M:format check")}

  lint
  {:doc "Lint Clojure source with clj-kondo"
   :task (clojure
          (str "-M:lint --lint src test build build.clj bb.edn book/chapters "
               "examples/aero-profiles/src examples/aero-profiles/test "
               "examples/aero-profiles/bb.edn examples/quickstart-bb/src "
               "examples/quickstart-bb/bb.edn examples/integrant-service/src "
               "examples/integrant-service/test examples/integrant-service/build "
               "examples/team-ci/bb.edn"))}

  ;;;; Building and publishing

  clean
  {:doc "Remove the target/ build directory"
   :task (clojure "-T:build clean")}

  build
  {:doc "Build the development library jar (target/secrets-<version>.jar)"
   :task (clojure "-T:build jar")}

  install
  {:doc "Build + install the development jar to the local Maven repo (~/.m2)"
   :task (clojure "-T:build install")}

  release
  {:doc "Guarded release build from the release tag (writes target/release.edn)"
   :task (clojure "-T:build release")}

  deploy
  {:doc "Publish the receipted release artifact to Clojars (run `bb release` first)"
   ;;; Not `-T:build`: the upload is the only step holding a credential, so it
   ;;; runs on :deploy's own replaced classpath — the publisher, the release
   ;;; guards, and Maven's deploy code, with no build tooling on it.
   :task (clojure "-M:deploy")}

  secrets
  {:doc "Demo of the management CLI against a throwaway tmp/ secrets file"
   :requires ([com.kirahowe.secrets.cli :as cli])
   :task (cli/run! {:app "kira-secrets-demo"
                    :default-environment :dev
                    :environments {:dev {:secrets-file "tmp/secrets.edn.age"}}}
                   *command-line-args*)}

  ;;;; Documentation book
  ;;; The book tasks shell out to `clojure -M:book`, so they need a JDK and the
  ;;; `quarto` CLI on the PATH (and `age`, since the chapters run real examples).

  book:build
  {:doc "Render the documentation book (Clay + Quarto) into book/rendered"
   :requires ([babashka.fs :as fs])
   :task (do (when (fs/exists? "book/rendered")
               (fs/delete-tree "book/rendered"))
             (clojure "-M:book -m scicloj.clay.v2.main -r")
             (run 'book:policy))}

  book:policy
  {:doc "Strip third-party assets from book/rendered, add its CSP, and check the result"
   ;;; Part of book:build rather than a separate gate, so a local render cannot
   ;;; produce an artifact that would fail CI. book:preview and book:watch do
   ;;; not run it: quarto preview re-renders as you save, so the next render
   ;;; would overwrite the rewrite. Those tasks serve a development render;
   ;;; `bb book:build` is what produces the published artifact, and it is the
   ;;; only one CI uploads.
   :requires ([com.kirahowe.secrets.site-policy :as site-policy])
   :task (let [rewritten (site-policy/rewrite! "book/rendered")
               found (site-policy/violations "book/rendered")]
           (println "Rewrote" (count rewritten) "file(s) in book/rendered")
           (when (seq found)
             (run! (comp println site-policy/finding-message) found)
             (println (count found) "site policy violation(s)")
             (System/exit 1))
           (println "book/rendered ships no third-party executable assets"))}

  book:preview
  {:doc "Serve the rendered book locally via `quarto preview` (builds first if needed)"
   :requires ([babashka.fs :as fs])
   :task (do (when-not (fs/exists? "book/rendered/_quarto.yml")
               (run 'book:build))
             (shell "quarto preview book/rendered"))}

  book:watch
  {:doc "Re-render a chapter when you save it and reload the browser in place"
   :requires ([babashka.fs :as fs])
   ;; Start from a clean slate: a previous book:build leaves its HTML and
   ;; Quarto's cache here, and this run should serve only what it rendered.
   ;; Extra arguments go to `quarto preview` (`--no-browser`, `--port 4444`).
   :task (do (when (fs/exists? "book/rendered")
               (fs/delete-tree "book/rendered"))
             (apply clojure "-M:book" "-m" "com.kirahowe.secrets.book-watch"
                    *command-line-args*))}}}
